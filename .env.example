# Environment Configuration for NEXUS Platform
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=nexus_super_secret_jwt_key_change_in_production_2025_safe_hash
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# Vector Storage (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=True

# AWS Bedrock & S3 Configuration (Optional for local mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexus-enterprise-docs
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
USE_AWS_BEDROCK=False

# Observability & Cost Tracking
COST_PER_INPUT_TOKEN_HAIKU=0.00000025
COST_PER_OUTPUT_TOKEN_HAIKU=0.00000125
COST_PER_INPUT_TOKEN_SONNET=0.000003
COST_PER_OUTPUT_TOKEN_SONNET=0.000015
